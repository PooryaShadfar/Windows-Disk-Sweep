<!-- Disk Sweep main window. Loaded at runtime (XamlReader); colors come from Theme in App.cs. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk Sweep" Width="1160" Height="800" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Buttons -->
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
              <Border x:Name="hov" Background="{DynamicResource Text}" CornerRadius="7" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="Opacity" Value="0.06"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="hov" Property="Opacity" Value="0.12"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
    </Style>
    <Style x:Key="Subtle" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Thin bar (drive usage + cleaning progress) -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Track}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim scrollbars -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="{DynamicResource Thumb}" Margin="2,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A whole result row is one big checkbox -->
    <Style x:Key="RowCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="row" Background="Transparent" CornerRadius="9" Padding="14,11" BorderThickness="1" BorderBrush="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="box" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5"
                        BorderBrush="{DynamicResource Muted}" Background="Transparent"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12"
                             Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="row" Property="Background" Value="{DynamicResource Selected}"/>
                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource SelectedLine}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="7"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>

    <!-- Segmented choice (theme) and small chips (drives) -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bd" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}"/>
              <Border x:Name="hov" CornerRadius="7" Background="{DynamicResource Text}" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="Opacity" Value="0.06"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton" BasedOn="{StaticResource Seg}">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- On/off switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/>
              <Border x:Name="track" Grid.Column="1" Width="42" Height="22" CornerRadius="11" BorderThickness="1.5"
                      BorderBrush="{DynamicResource Muted}" Background="Transparent" VerticalAlignment="Center">
                <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,22,0,10"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="28,22,28,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="46" Height="46" CornerRadius="12">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#2B88D8" Offset="0"/>
              <GradientStop Color="#0F5FA8" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Disk Sweep" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="See what fills your drive. You decide what goes." Style="{StaticResource Caption}" FontSize="13.5"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BtnAdmin" Style="{StaticResource Secondary}" Margin="0,0,10,0"
                ToolTip="Some system folders can only be cleaned with administrator rights.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
            <TextBlock Text="Run as administrator"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnFolder" Style="{StaticResource Secondary}" Margin="0,0,10,0"
                ToolTip="Add your code folders. Disk Sweep then lists node_modules, build caches and build output inside them.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
            <TextBlock Text="Code folders"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnSettings" Style="{StaticResource Secondary}" Margin="0,0,10,0" Padding="11,8"
                ToolTip="Settings" AutomationProperties.Name="Settings">
          <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/>
        </Button>
        <Button x:Name="BtnScan" Style="{StaticResource Primary}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
            <TextBlock Text="Scan again"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Summary cards -->
    <Grid Grid.Row="1" Margin="28,0,28,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
              <TextBlock x:Name="DriveLabel" Text="Drive C:" Style="{StaticResource Caption}"/>
            </StackPanel>
            <ItemsControl x:Name="Drives" HorizontalAlignment="Right" Margin="0,-4,0,-4" AutomationProperties.Name="Drives">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Style="{StaticResource Chip}" GroupName="drives" Content="{Binding Label}"
                               IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding Tip}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <TextBlock x:Name="DriveFree" Text="…" Style="{StaticResource Big}"/>
          <ProgressBar x:Name="DriveBar" Style="{StaticResource Bar}" Maximum="100" Margin="0,10,0,8"/>
          <TextBlock x:Name="DriveSub" Style="{StaticResource Caption}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
            <TextBlock Text="You can free" Style="{StaticResource Caption}"/>
          </StackPanel>
          <TextBlock x:Name="FoundText" Text="…" Style="{StaticResource Big}" Foreground="{DynamicResource Accent}"/>
          <TextBlock x:Name="FoundSub" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73A;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
            <TextBlock Text="Selected to clean" Style="{StaticResource Caption}"/>
          </StackPanel>
          <TextBlock x:Name="SelText" Text="0 B" Style="{StaticResource Big}"/>
          <TextBlock x:Name="SelSub" Text="Tick items below" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Body: categories + results -->
    <Grid Grid.Row="2" Margin="28,0,28,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Style="{StaticResource Badge}" Margin="0" Background="{DynamicResource SafeBg}">
                <TextBlock Text="Safe" Foreground="{DynamicResource SafeFg}" FontSize="11.5" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="Rebuilds by itself" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Style="{StaticResource Badge}" Margin="0" Background="{DynamicResource ReviewBg}">
                <TextBlock Text="Check first" Foreground="{DynamicResource ReviewFg}" FontSize="11.5" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="Read the details" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}" Margin="0" Background="{DynamicResource AdminBg}">
                <TextBlock Text="Admin" Foreground="{DynamicResource AdminFg}" FontSize="11.5" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="Needs admin rights" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Style="{StaticResource Caption}" FontSize="11.5" FontWeight="SemiBold" Margin="10,2,0,8"/>
        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource Text}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="8" Padding="12,9" Margin="0,1" Background="Transparent">
                      <Grid>
                        <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface}"/>
                        <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="15"
                           VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource Muted}" FontSize="12.5"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,4,4,4">
        <Grid>
          <ListBox x:Name="List" Margin="4,0,0,4" Background="Transparent" BorderThickness="0" Padding="0,0,8,4"
                   Foreground="{DynamicResource Text}" KeyboardNavigation.TabNavigation="Continue"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                   AutomationProperties.Name="Items found">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Focusable" Value="False"/>
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Muted}" Margin="14,18,0,6"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <CheckBox Style="{StaticResource RowCheck}" AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsEnabled="{Binding IsAvailable}" Margin="0,1" ToolTip="{Binding Tip}"
                            ToolTipService.InitialShowDelay="700" ToolTipService.ShowOnDisabled="True">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <Border Style="{StaticResource Badge}" Background="{Binding BadgeBg}">
                            <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFg}" FontSize="11.5" FontWeight="SemiBold"/>
                          </Border>
                          <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{DynamicResource AdminBg}" Visibility="{Binding RecycleVis}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource AdminFg}"
                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                              <TextBlock Text="To Recycle Bin" Foreground="{DynamicResource AdminFg}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                          </Border>
                          <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="{DynamicResource AdminBg}" Visibility="{Binding AdminVis}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource AdminFg}"
                                         VerticalAlignment="Center" Margin="0,0,4,0"/>
                              <TextBlock Text="Admin" Foreground="{DynamicResource AdminFg}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding WarningVis}" Margin="0,4,0,0">
                          <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource WarnFg}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarnFg}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource Display}" FontSize="17"
                                 FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,4,0"/>
                      <Button Grid.Column="2" Tag="hide" Style="{StaticResource IconBtn}" Margin="6,0,0,0" VerticalAlignment="Center"
                              ToolTip="Don't show this again (undo in Settings)" AutomationProperties.Name="Hide this item">
                        <TextBlock Text="&#xED1A;" FontFamily="{StaticResource Icons}" FontSize="14"/>
                      </Button>
                    </Grid>
                  </CheckBox>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

          <!-- Scanning -->
          <StackPanel x:Name="ScanPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Grid Width="54" Height="54" HorizontalAlignment="Center">
              <Ellipse Stroke="{DynamicResource Track}" StrokeThickness="5"/>
              <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="5" StrokeDashArray="8 40" StrokeDashCap="Round"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <RotateTransform/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
            </Grid>
            <TextBlock x:Name="ScanText" Text="Scanning your drive…" FontFamily="{StaticResource Display}" FontSize="18"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="ScanSub" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"
                       MaxWidth="460" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <!-- Nothing found -->
          <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xE930;" Style="{StaticResource Glyph}" FontSize="44" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            <TextBlock Text="All clean" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock Text="Nothing worth removing was found here." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Nothing is deleted until you confirm." FontWeight="SemiBold" FontSize="13.5"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="BtnNone" Style="{StaticResource Subtle}" Content="Untick all" Margin="0,0,8,0"/>
          <Button x:Name="BtnSafe" Style="{StaticResource Secondary}" Margin="0,0,12,0"
                  ToolTip="Ticks every 'Safe' item in the current view.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE73A;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
              <TextBlock Text="Tick all safe"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnClean" Style="{StaticResource Primary}" Padding="22,10" IsEnabled="False">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/>
              <TextBlock x:Name="CleanLabel" Text="Clean selected"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Settings -->
    <Grid x:Name="SettingsOverlay" Grid.RowSpan="4" Background="#8C000000" Visibility="Collapsed">
      <Border Background="{DynamicResource Surface}" CornerRadius="14" Width="640" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35"/>
        </Border.Effect>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="28,20,18,4">
            <TextBlock Text="Settings" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="BtnCloseSettings" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" ToolTip="Close"
                    AutomationProperties.Name="Close settings">
              <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="14"/>
            </Button>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
            <StackPanel Margin="28,0,28,26">

              <TextBlock Text="Appearance" Style="{StaticResource Section}" Margin="0,8,0,10"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Seg}" GroupName="theme" Content="Same as Windows"/>
                <RadioButton x:Name="ThemeLight" Style="{StaticResource Seg}" GroupName="theme" Content="Light"/>
                <RadioButton x:Name="ThemeDark" Style="{StaticResource Seg}" GroupName="theme" Content="Dark"/>
              </StackPanel>

              <TextBlock Text="Safety" Style="{StaticResource Section}"/>
              <CheckBox x:Name="OptRecycle" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Send &quot;Check first&quot; items to the Recycle Bin" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                             Text="So you can restore them if you change your mind. Large files always go there."/>
                </StackPanel>
              </CheckBox>

              <TextBlock Text="Low-space alert" Style="{StaticResource Section}"/>
              <CheckBox x:Name="OptAlert" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Warn me when a drive is running out of space" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                             Text="Checks every 3 hours while you're signed in and shows a Windows notification. Uses Task Scheduler, nothing runs in the background."/>
                </StackPanel>
              </CheckBox>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Warn when free space is below" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="AlertGB" Style="{StaticResource Field}" Width="64" TextAlignment="Right" MaxLength="4"
                         AutomationProperties.Name="Warning limit in GB"/>
                <TextBlock Text="GB" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="AlertStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>

              <TextBlock Text="Hidden items" Style="{StaticResource Section}"/>
              <TextBlock x:Name="HiddenEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap"
                         Text="Nothing hidden. Use the eye button on an item to stop seeing it."/>
              <ItemsControl x:Name="HiddenList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="1" Tag="unhide" Style="{StaticResource Subtle}" Content="Show again" Padding="10,5"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="History" Style="{StaticResource Section}"/>
              <TextBlock x:Name="HistTotal" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
              <TextBlock x:Name="HistSub" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
              <ItemsControl x:Name="HistList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Name="BtnClearHist" Style="{StaticResource Subtle}" Content="Clear history" HorizontalAlignment="Left" Margin="-14,6,0,0"/>

              <TextBlock Text="About" Style="{StaticResource Section}"/>
              <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
              <Button x:Name="BtnGitHub" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
                  <TextBlock Text="Open on GitHub"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Dialog overlay (confirm / progress / result) -->
    <Grid x:Name="Overlay" Grid.RowSpan="4" Background="#8C000000" Visibility="Collapsed">
      <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="28,24" Width="540"
              HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock x:Name="DlgTitle" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
          <Border x:Name="DlgListBox" Background="{DynamicResource Bg}" CornerRadius="9" Margin="0,16,0,0" Padding="16,8,8,8">
            <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="DlgList" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="16,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <StackPanel x:Name="DlgWarnRow" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource WarnFg}" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"/>
            <TextBlock x:Name="DlgWarn" TextWrapping="Wrap" Foreground="{DynamicResource WarnFg}" MaxWidth="450"/>
          </StackPanel>
          <ProgressBar x:Name="DlgProgress" Style="{StaticResource Bar}" Margin="0,20,0,0"/>
          <TextBlock x:Name="DlgStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
          <StackPanel x:Name="DlgButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="DlgAlt" Style="{StaticResource Subtle}" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="DlgCancel" Style="{StaticResource Secondary}" Content="Cancel" Margin="0,0,10,0" MinWidth="96"/>
            <Button x:Name="DlgOk" Style="{StaticResource Danger}" Content="Delete" MinWidth="96"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
